{
  "name": "velvetaura",
  "version": "1.0.0",
  "description": "VelvetAura - Luxury Imported Beauty E-Commerce Platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node src/data/seed.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:e2e": "node tests/e2e/runner.js"
  },
  "keywords": [
    "velvetaura",
    "ecommerce",
    "express",
    "mongodb",
    "glassmorphism",
    "luxury-beauty"
  ],
  "author": "VelvetAura Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb-memory-server": "^9.2.0",
    "mongoose": "^8.3.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^6.3.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "testMatch": [
      "<rootDir>/tests/*.test.js",
      "<rootDir>/tests/unit/*.test.js",
      "<rootDir>/tests/integration/*.test.js"
    ],
    "testTimeout": 60000
  },
  "allowScripts": {
    "mongodb-memory-server@9.5.0": true
  }
}
